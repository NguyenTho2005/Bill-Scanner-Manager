# =============================================================================
# BillTracker Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env with real secrets to version control.
# For production, use a secrets manager (e.g. AWS Secrets Manager, HashiCorp Vault).
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Options: development | staging | production
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL async URL
DATABASE_URL=postgresql+asyncpg://billtracker:CHANGE_ME@localhost:5432/billtracker

# ── JWT / Auth ────────────────────────────────────────────────────────────────
# For dev only: use RS256 with an ephemeral key generated at startup.
# For production: provide RSA private key PEM or path to key file.
JWT_ALGORITHM=RS256

# Path to RSA private key PEM (production) — leave empty in dev mode
# JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key
# JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=90

# A random secret for HMAC operations (NOT the JWT signing key)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_urlsafe_64

# ── Dev/Mock Auth (ONLY for local development) ───────────────────────────────
# Set to false in staging/production — this enables a mock OIDC endpoint
# that issues tokens without verifying against Apple/Google.
DEV_AUTH_ENABLED=true
DEV_AUTH_MOCK_ISSUER=http://localhost:8000

# ── Apple Sign In (Production) ────────────────────────────────────────────────
# APPLE_CLIENT_ID=com.example.billtracker
# APPLE_TEAM_ID=XXXXXXXXXX
# APPLE_KEY_ID=XXXXXXXXXX
# APPLE_PRIVATE_KEY_PATH=/run/secrets/apple_sign_in_key

# ── Google Sign In (Production) ───────────────────────────────────────────────
# GOOGLE_CLIENT_ID=XXXXXXXXXX.apps.googleusercontent.com

# ── Object Storage (S3-compatible) ────────────────────────────────────────────
# For local dev: MinIO
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=billtracker-media
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
# Pre-signed URL TTLs (seconds)
S3_UPLOAD_URL_TTL=900
S3_DOWNLOAD_URL_TTL=300

# For production AWS S3: remove S3_ENDPOINT and use IAM roles instead of keys.
# AWS_DEFAULT_REGION=ap-southeast-1

# ── Media Limits ──────────────────────────────────────────────────────────────
# Maximum file size for original images (bytes)
MEDIA_MAX_ORIGINAL_BYTES=20971520
# Maximum file size for compressed images (bytes)
MEDIA_MAX_COMPRESSED_BYTES=5242880
# Maximum thumbnail size (bytes)
MEDIA_MAX_THUMBNAIL_BYTES=204800
# Storage quota per user (bytes, default 2 GB)
MEDIA_QUOTA_PER_USER_BYTES=2147483648

# ── Optional Cloud Assistant (P2, opt-in) ────────────────────────────────────
# Leave LLM_API_KEY empty to keep POST /v1/assistant/chat disabled (503).
# The mobile app always answers spending questions on-device; this proxy is
# only for free-form follow-ups when the user opts in.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...
# LLM_TIMEOUT_SECONDS=30
# LLM_TEMPERATURE=0.3

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
# Rates are defined in code (slowapi). Override here if needed.
# RATE_LIMIT_AUTH_PER_MIN=10
# RATE_LIMIT_SYNC_PUSH_PER_MIN=30
# RATE_LIMIT_SYNC_PULL_PER_MIN=60

# ── Sync Settings ─────────────────────────────────────────────────────────────
SYNC_MAX_PUSH_OPS=100
SYNC_MAX_PULL_LIMIT=200
SYNC_IDEMPOTENCY_TTL_DAYS=7

# ── Account Lifecycle ─────────────────────────────────────────────────────────
# Days before scheduled deletion is executed
ACCOUNT_DELETION_GRACE_DAYS=30
# Export job download URL TTL (seconds, 24 hours)
EXPORT_DOWNLOAD_URL_TTL=86400

# =============================================================================
# SECURITY NOTES:
# - Never log ACCESS_TOKEN, REFRESH_TOKEN, pre-signed URLs, or user financial data.
# - For production: rotate SECRET_KEY and JWT keys regularly.
# - Database credentials should use least-privilege DB user (read/write only, no DDL).
# - S3 bucket must be PRIVATE. Pre-signed URLs are the only way to access objects.
# =============================================================================
